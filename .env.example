# Video directories configuration
# Comma-separated list of directories to watch for video files
# These are the container paths where videos will be accessible
VIDEO_DIRS=/app/data/videos,/app/custom_videos

# Host video directories configuration
# Comma-separated list of host directories to mount to the container paths above
# Each path corresponds to the VIDEO_DIRS paths in order
# Example: HOST_VIDEO_PATHS=/home/user/videos,/media/external/movies,/data/recordings
# Leave empty to use ./data/videos as default for all custom paths
HOST_VIDEO_PATHS=

# Database configuration
DATABASE_URL=postgresql://videotranscriber:videotranscriber@postgres/videotranscriber

# Storage backend configuration
STORAGE_BACKEND=local_fs

# S3-compatible storage bridge configuration
# Used when STORAGE_BACKEND=s3_compatible and object storage is mounted locally
S3_STORAGE_BUCKET=video-transcriber
S3_STORAGE_PREFIX=uploads
S3_STORAGE_MOUNT_ROOT=/app/data/object-storage

# Live update backplane configuration
LIVE_UPDATES_NOTIFY_ENABLED=1
LIVE_UPDATES_CHANNEL=video_transcriber_live_updates
LIVE_UPDATES_RECONNECT_SECONDS=5

# Logging and operational metrics
LOG_LEVEL=INFO
LOG_FORMAT=json
METRICS_RECORDING_ENABLED=1
METRICS_DEFAULT_LOOKBACK_HOURS=168

# LLM configuration
LLM_HOST=http://ollama:11434/api/generate
LLM_MODEL=qwen3:14b
SUMMARIZATION_LLM_MODEL=mistral-small3.1
TRANSLATION_LLM_MODEL=qwen3:14b

# HuggingFace configuration
HF_TOKEN=your_huggingface_token_here

# API configuration

# Worker configuration
MAX_WORKERS=1

# Database initialization
SKIP_DB_INIT=false

# PostgreSQL configuration
POSTGRES_USER=videotranscriber
POSTGRES_PASSWORD=videotranscriber
POSTGRES_DB=videotranscriber

# Port configurations
FRONTEND_PORT=5555
API_PORT=8000
POSTGRES_PORT=5435
OLLAMA_PORT=11434
